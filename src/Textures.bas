Attribute VB_Name = "Textures"
'==============================================================================
' Textures: every texture is generated by code, so the repository needs no
' binary assets. A texel stores a ColorId; shading is applied by the renderer.
'==============================================================================
Option Explicit

Public Tex() As Long            ' Tex(texture 1..NUM_TEXTURES, x, y)
Public Gem() As Long            ' Gem(x, y): ColorId, or -1 for transparent

Public Sub Build()
    Dim x As Long
    Dim y As Long

    ReDim Tex(1 To NUM_TEXTURES, 0 To TEX_SIZE - 1, 0 To TEX_SIZE - 1)
    ReDim Gem(0 To TEX_SIZE - 1, 0 To TEX_SIZE - 1)

    For y = 0 To TEX_SIZE - 1
        For x = 0 To TEX_SIZE - 1
            Tex(1, x, y) = Brick(x, y)
            Tex(2, x, y) = Stone(x, y)
            Tex(3, x, y) = Wood(x, y)
            Tex(4, x, y) = Metal(x, y)
            Tex(5, x, y) = Moss(x, y)
            Gem(x, y) = GemTexel(x, y)
        Next x
    Next y
End Sub

' Small deterministic hash, 0..10. Stands in for noise.
Private Function Hash(ByVal x As Long, ByVal y As Long, ByVal seed As Long) As Long
    Hash = (x * 73 + y * 151 + seed * 199 + x * y * 31) Mod 11
End Function

' Running-bond brickwork: a mortar line every 4 rows, joints offset per course.
Private Function Brick(ByVal x As Long, ByVal y As Long) As Long
    Dim course As Long

    course = y \ 4
    If (y And 3) = 3 Then
        Brick = colMortar
    ElseIf ((x + (course And 1) * 4) And 7) = 7 Then
        Brick = colMortar
    Else
        Brick = colBrick
    End If
End Function

' 8x8 stone blocks with dark joints and a few dark speckles.
Private Function Stone(ByVal x As Long, ByVal y As Long) As Long
    If (x And 7) = 0 Or (y And 7) = 0 Then
        Stone = colStoneDark
    ElseIf Hash(x, y, 1) = 0 Then
        Stone = colStoneDark
    Else
        Stone = colStone
    End If
End Function

' Vertical planks, 4 texels wide, with dark grain.
Private Function Wood(ByVal x As Long, ByVal y As Long) As Long
    If (x And 3) = 3 Then
        Wood = colWoodDark
    ElseIf Hash(x \ 4, y, 2) < 2 Then
        Wood = colWoodDark
    Else
        Wood = colWood
    End If
End Function

' Riveted metal panel with a dark frame and a seam across the middle.
Private Function Metal(ByVal x As Long, ByVal y As Long) As Long
    If x = 0 Or y = 0 Or x = TEX_SIZE - 1 Or y = TEX_SIZE - 1 Then
        Metal = colStoneDark
    ElseIf (x = 2 Or x = 13) And (y = 2 Or y = 13) Then
        Metal = colWhite
    ElseIf y = 7 Or y = 8 Then
        Metal = colStoneDark
    Else
        Metal = colMetal
    End If
End Function

' Stone blocks with moss that gets thicker towards the floor.
Private Function Moss(ByVal x As Long, ByVal y As Long) As Long
    If Hash(x, y, 3) < y \ 3 Then
        Moss = colMoss
    Else
        Moss = Stone(x, y)
    End If
End Function

' A diamond with a highlight on its upper-left facet.
Private Function GemTexel(ByVal x As Long, ByVal y As Long) As Long
    Dim d As Long

    d = Abs(2 * x - (TEX_SIZE - 1)) + Abs(2 * y - (TEX_SIZE - 1))
    If d > TEX_SIZE - 2 Then
        GemTexel = -1
    ElseIf x < TEX_SIZE \ 2 And y < TEX_SIZE \ 2 And d <= TEX_SIZE \ 2 Then
        GemTexel = colWhite
    Else
        GemTexel = colGold
    End If
End Function
